# ==============================================================================
# Notenux Rust Backend API Configuration (.env.example)
# Runs high-performance note metadata and chunk streaming at http://localhost:8999
# ==============================================================================

# Database Connection (MySQL / MariaDB on shared hosting or local container)
DATABASE_URL=mysql://notenux:secret@127.0.0.1:39285/notenux

# Server Binding
HOST=127.0.0.1
PORT=8999

# CORS Allowed Origins
# Default configured origins include:
# - http://localhost:5173
# - https://app.notenux.oryphem.com
# - Custom origin defined below:
CORS_ORIGIN=http://localhost:5173

# Bounded In-Memory LRU Cache (Moka)
# Clamped between 1 MB and 45 MB (Default 45 MB) with 30-minute TTL for notes & chunks,
# and 10-minute TTL for Laravel Sanctum authentication tokens.
CACHE_LIMIT_MB=45

# Database Connection Pool Safety for Shared Hosting
MAX_DB_CONNECTIONS=5
MIN_DB_CONNECTIONS=1

# Logging level
RUST_LOG=info,be_notenux=debug
